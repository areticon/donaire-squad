generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String?
  emailVerified    Boolean   @default(false)
  image            String?
  plan             String    @default("free")
  stripeCustomerId String?
  /// Saldo de créditos do ciclo atual. Reposto pelo webhook do Stripe a cada
  /// renovação. Nunca alterar direto: use lib/credits, que grava o extrato
  /// junto na mesma transação.
  creditsBalance   Int       @default(0)
  /// Quando o saldo foi reposto pela última vez.
  creditsResetAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  projects Project[]
  sessions Session[]
  accounts Account[]
  creditTx CreditTransaction[]

  @@map("users")
}

/// Extrato de créditos, uma linha por movimento.
///
/// Existe separado do saldo porque saldo sozinho não responde as perguntas que
/// importam: onde o cliente gastou, se a cobrança bate com o que foi entregue,
/// e o que devolver quando algo falha no meio. Débito é negativo, crédito é
/// positivo, e a soma do extrato tem que bater com o saldo.
model CreditTransaction {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  /// Negativo debita, positivo credita.
  amount    Int
  /// O que gerou: "video_job", "post_text", "recarga", "renovacao", "estorno".
  operation String
  /// Id do que gerou, para conciliar entrega com cobrança.
  refId     String?
  /// Saldo depois deste movimento, para auditar sem somar o extrato inteiro.
  balance   Int
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([operation, refId])
  @@map("credit_transactions")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model Project {
  id             String   @id @default(cuid())
  userId         String
  name           String
  description    String?
  status         String   @default("setup")
  setupStep      Int      @default(0)
  config         Json?
  voice          String?
  niche          String?
  targetAudience String?
  colorPalette   String?
  /// O estilo de edicao de video: "dramatico", "acelerado", "serio" ou
  /// "animado". Fica no PROJETO e nao no envio de cada video, por decisao do
  /// Bruno em 24/08: canal com estilo diferente a cada video nao constroi
  /// reconhecimento. Nulo cai no acelerado, ver lib/media/estilos.ts.
  videoStyle     String?
  /// A trilha dos cortes, que o CLIENTE traz. Decisao juridica de 23/08: a
  /// Demandou nunca distribui musica, ela e ferramenta de edicao como o
  /// CapCut. A engenharia e a mesma para biblioteca do YouTube (so CC-BY),
  /// assinatura propria ou faixa autoral.
  videoMusicUrl  String?  @db.Text
  videoMusicName String?
  /// Termos do negocio do cliente que a transcricao costuma errar (nomes
  /// proprios, siglas: "Areticon", "SaaS"). Texto separado por virgula, que o
  /// cliente edita na tela de video. Pedido do Bruno em 30/08, depois de a
  /// legenda escrever o nome da empresa dele errado. Alimenta o keyterm da
  /// Deepgram na transcricao nova e a correcao deterministica das palavras.
  videoTerms     String?  @db.Text
  /// Como o cliente quer a semana a partir de cada gravacao: formato por dia
  /// (terca a domingo; segunda e sempre o video). Chaves "2".."7", valor
  /// "text" | "image" | "carousel" | "infographic" | "thread" | "poll" | "free"
  /// ou nulo para dia sem post. Nulo inteiro cai na sugestao do squad, ver
  /// lib/media/semana-do-video.ts. Pedido do Bruno em 02/09: mesmo com o video
  /// como fonte, quem escolhe o formato de cada dia e o cliente, nao o squad.
  videoSemana    Json?
  /// O estilo da capa (thumbnail) do video completo no YouTube: "impacto",
  /// "limpo" ou "manchete", ver lib/media/capas-do-completo.ts. Fica no
  /// projeto pelo mesmo motivo do videoStyle: capa igual em todo video e o
  /// que faz o canal ser reconhecido na listagem. Pedido do Bruno em 02/09,
  /// junto com "pelo menos 2 opcoes" por video.
  capaEstilo     String?
  postFrequency  String?
  timezone       String   @default("America/Sao_Paulo")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User             @relation(fields: [userId], references: [id])
  agents         ProjectAgent[]
  socialAccounts SocialAccount[]
  posts          Post[]
  runs           PipelineRun[]
  memories       ProjectMemory[]
  cards          CampaignCard[]
  contexts       ProjectContext[]
  videoJobs      VideoJob[]

  @@map("projects")
}

model ProjectAgent {
  id        String   @id @default(cuid())
  projectId String
  agentId   String
  name      String
  role      String
  persona   String?
  style     String?
  skills    Json     @default("[]")
  tasks     Json     @default("[]")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_agents")
}

model SocialAccount {
  id               String    @id @default(cuid())
  projectId        String
  platform         String
  accountType      String    @default("personal") // "personal" | "organization"
  organizationId   String? // LinkedIn org numeric ID (only for accountType=organization)
  blotatoAccountId String?
  displayName      String?
  username         String?
  platformUserId   String?
  avatarUrl        String?
  accessToken      String?
  refreshToken     String?
  tokenExpiresAt   DateTime?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  posts   Post[]

  @@unique([projectId, platform, platformUserId])
  @@map("social_accounts")
}

model Post {
  id                 String    @id @default(cuid())
  projectId          String
  socialAccountId    String?
  platform           String
  content            String
  imageUrl           String? // base64 data URL — limpo após publicação
  imagePrompt        String? // prompt que gerou a mídia — guardado permanentemente
  mediaType          String? // "text" | "image" | "video" | "carousel" | "poll" | "article" | "thread"
  metadata           Json? // structured data: poll options, thread tweets, carousel slide count
  dayOfWeek          Int? // 1=Seg … 7=Dom
  // draft | scheduled | published | failed | rejected | cancelled
  status             String    @default("draft")
  scheduledAt        DateTime?
  publishedAt        DateTime?
  externalUrl        String?
  externalId         String?
  sourcesComment     String?
  /// Token opaco para URL pública do artigo LinkedIn (/a/[token]) — texto completo fora do limite de post
  articlePublicToken String?   @unique
  runId              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount? @relation(fields: [socialAccountId], references: [id])
  run           PipelineRun?   @relation(fields: [runId], references: [id])
  metrics       PostMetric?
  cards         CampaignCard[]

  @@map("posts")
}

model PipelineRun {
  id           String    @id @default(cuid())
  projectId    String
  status       String    @default("running")
  topic        String?
  campaignMode String    @default("weekly") // "single" | "weekly" | "biweekly" | "recurring"
  weekStart    DateTime? // Monday of the target week (ISO)
  config       Json? // { funnelStage, weeklySchedule, singleDay?, singlePlatform? }
  output       Json?
  logs         Json      @default("[]")
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  archived     Boolean   @default(false)
  archivedAt   DateTime?

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  posts   Post[]
  cards   CampaignCard[]

  @@map("pipeline_runs")
}

model PostMetric {
  id          String   @id @default(cuid())
  postId      String   @unique
  impressions Int      @default(0)
  likes       Int      @default(0)
  comments    Int      @default(0)
  shares      Int      @default(0)
  clicks      Int      @default(0)
  videoViews  Int      @default(0)
  syncedAt    DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("post_metrics")
}

model CampaignCard {
  id            String    @id @default(cuid())
  runId         String
  projectId     String
  agentId       String
  agentName     String
  dayOfWeek     Int // 1=Mon … 7=Sun
  scheduledDate DateTime? // actual calendar date of this card
  cardType      String // "research" | "post_linkedin" | "post_twitter" | "media" | "preview" | "publish"
  mediaType     String? // "image" | "video" | "carousel" | "poll" | "article" | "thread"
  content       String?   @db.Text
  mediaUrl      String?   @db.Text
  metadata      Json? // structured data: poll options, thread tweets
  status        String    @default("pending")
  postId        String?
  chatHistory   Json      @default("[]")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  run     PipelineRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  post    Post?       @relation(fields: [postId], references: [id])

  @@map("campaign_cards")
}

model ProjectContext {
  id        String   @id @default(cuid())
  projectId String
  type      String // "brand" | "references" | "regulations" | "editorial" | "examples"
  title     String
  rawInput  String   @db.Text
  compiled  String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_contexts")
}

/// Um vídeo cru enviado pelo cliente e tudo que o squad extrai dele.
/// O arquivo em si mora no object storage; aqui ficam só os metadados, a
/// transcrição e os cortes escolhidos. Vídeo nunca vai para dentro do Postgres.
model VideoJob {
  id             String    @id @default(cuid())
  projectId      String
  userId         String
  /// Estados de ESPERA (a plataforma aguarda o cliente):    uploaded,
  /// transcribed, selected, cut, ready, failed.
  /// Estados de TRABALHO (algo está rodando agora):          transcribing,
  /// selecting, writing, cutting.
  ///
  /// `cutting` é o primeiro que roda FORA da requisição de verdade: quem
  /// trabalha é o worker no Railway, e o prazo aqui é só a rede de segurança
  /// para o caso de o aviso dele nunca chegar.
  ///
  /// A separação existe porque antes não existia: "selecting" queria dizer ao
  /// mesmo tempo "pronto para selecionar" e "selecionando agora". Quando a
  /// Vercel matava a função no teto de tempo, o `catch` nunca rodava e o status
  /// ficava exatamente igual ao de quem nunca tinha começado. A falha era
  /// invisível por construção. Ver `lib/media/video-state.ts`.
  status         String    @default("uploaded")
  /// Quando o estado de TRABALHO atual começou. Null em estado de espera.
  /// É isto que permite declarar morto o trabalho que passou do prazo, que é o
  /// único jeito de perceber uma função derrubada pela plataforma: ela não
  /// consegue gravar o próprio erro.
  startedAt      DateTime?
  /// Quantas vezes a etapa atual foi tentada. Existe para a fila não repetir
  /// para sempre um trabalho que falha sozinho.
  attempts       Int       @default(0)
  originalName   String?
  blobUrl        String    @db.Text
  sizeBytes      BigInt?
  durationSec    Int?
  /// Transcrição com marcação de tempo por palavra, vinda do Whisper.
  transcript     Json?
  /// A pesquisa do Roberto Radar feita a partir da transcricao (teses com
  /// minuto, o que estao falando, dados com fonte, angulo por dia). E o
  /// briefing que todo redator recebe junto com a transcricao, e mora aqui
  /// porque nasce antes de existir run ou card. Ver lib/media/radar-do-video.ts.
  radar          Json?
  /// Trechos escolhidos pela IA: início, fim, motivo, título e os textos de
  /// cada rede gerados a partir dele. Depois do corte, cada trecho ganha
  /// também a mídia produzida (vertical, horizontal, capa), o enquadramento
  /// que o squad decidiu, e as escolhas do cliente sobre publicar e para onde.
  clips          Json?
  /// A gravação inteira, recodificada para o canal: faststart, tamanho menor.
  /// Medido em 22/08: 811 MB de upload viraram cerca de 140 MB aqui, o que
  /// ataca a transferência, que é 58% do custo do produto de vídeo.
  completoUrl    String?   @db.Text
  completoBytes  BigInt?
  /// O quadro com o melhor rosto da gravação inteira, escolhido pelo squad.
  /// Base de todas as capas. Mora aqui e não no trecho porque os melhores
  /// momentos de FALA não coincidem com os melhores momentos de IMAGEM: numa
  /// gravação com slides, todos os trechos escolhidos caem em tela
  /// compartilhada, e a capa saía com texto branco em cima de um slide.
  capaFonteUrl   String?   @db.Text
  /// As opcoes de capa do video completo, compostas sobre o quadro-fonte:
  /// { estilo, opcoes: [{ url, frase, expressao }], escolhida, geradaEm }.
  /// Ate 02/09 o completo subia ao YouTube SEM capa: o quadro-fonte existia
  /// so como poster do player. Ver lib/media/capas-do-completo.ts.
  capas          Json?
  /// O que o especialista achou da MATERIA-PRIMA, em uma frase, para o cliente
  /// ler.
  ///
  /// Existe porque o Bruno pediu em 24/08 que a plataforma fosse honesta em vez
  /// de encher cota: "olha, nosso especialista analisou e viu que seu video tem
  /// 2 possiveis cortes". Sem este campo, a analise ficava so no log do
  /// servidor, e o cliente via seis cortes viram dois sem nenhuma explicacao,
  /// que parece defeito e nao criterio.
  diagnostico    String?   @db.Text
  error          String?   @db.Text
  creditsCharged Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Um arquivo, um registro, garantido pelo banco. A checagem na aplicação
  /// não bastava: as duas rotas que criam o registro leem antes de qualquer
  /// uma escrever, então a corrida passava por baixo dela.
  @@unique([projectId, blobUrl])
  @@index([projectId, createdAt])
  @@index([status])
  @@index([status, startedAt])
  @@map("video_jobs")
}

/// Consumo real de cada chamada de IA. Existe para responder duas perguntas
/// que o modelo de negócio depende: quanto custa de verdade cada operação, e
/// o prompt caching está pegando (cacheReadInputTokens maior que zero).
model AiUsage {
  id                       String   @id @default(cuid())
  projectId                String?
  runId                    String?
  agentId                  String?
  operation                String
  model                    String
  inputTokens              Int      @default(0)
  outputTokens             Int      @default(0)
  cacheCreationInputTokens Int      @default(0)
  cacheReadInputTokens     Int      @default(0)
  costUsd                  Decimal  @db.Decimal(12, 8)
  createdAt                DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([runId])
  @@map("ai_usage")
}

model ProjectMemory {
  id        String   @id @default(cuid())
  projectId String
  type      String
  key       String
  value     Json
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, type, key])
  @@map("project_memories")
}

/// Cada uso da demonstração pública da landing.
///
/// Existe por três motivos, nesta ordem: conter abuso (endpoint público que
/// chama a API do Claude é carteira aberta), medir a conversão da demo em
/// cadastro, e guardar o que as pessoas escrevem, que é a melhor pesquisa de
/// posicionamento que existe, porque vem de quem ainda não é cliente.
///
/// O IP nunca é gravado em texto puro: só o hash com sal do BETTER_AUTH_SECRET.
model DemoRun {
  id              String   @id @default(cuid())
  ipHash          String
  input           String   @db.Text
  output          Json?
  error           String?  @db.Text
  costUsd         Float    @default(0)
  /// Preenchido se a pessoa criar conta depois, para medir a conversão da demo.
  convertedUserId String?
  createdAt       DateTime @default(now())

  @@index([ipHash, createdAt])
  @@index([createdAt])
  @@map("demo_runs")
}
