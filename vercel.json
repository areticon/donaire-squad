{
  "crons": [
    {
      "path": "/api/cron/pipeline",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/annual-credits",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/fila",
      "schedule": "* * * * *"
    }
  ],
  "functions": {
    "app/api/videos/**/route.ts": {
      "maxDuration": 800
    },
    "app/api/ai/**/route.ts": {
      "maxDuration": 120
    },
    "app/api/projects/**/route.ts": {
      "maxDuration": 120
    }
  }
}
