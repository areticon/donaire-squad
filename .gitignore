# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# clerk configuration (can include secrets)
/.clerk/
.claude/settings.local.json
.claude/

# Artefatos de teste local (audio gerado, scripts descartaveis)
scripts/tmp/
__pycache__/

# Material intermediario das imagens da landing: regeravel pelos scripts em
# scripts/tmp, e video nao precisa morar no repositorio.
public/exemplo/novos/*.mp4
# As fotos cruas do carrossel, antes da legenda: regeraveis pelo script e
# pesadas demais para o repositorio. Vao para o site so as prontas.
public/exemplo/carrossel/*-cru.jpg

# Permissoes locais do Claude Code, pessoais e nao versionadas
.claude/settings.local.json

# Arte dos agentes: os brutos em 2K e os PNG recortados ficam só na máquina
# (fonte para regerar); o produto usa os WebP leves.
public/agentes/bruto/
public/agentes/*.png

# Editor completo (30/09): dependências e bundle do Remotion no worker
/worker/node_modules
/worker/remotion/build
