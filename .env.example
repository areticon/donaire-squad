# === Obrigatório para o app subir ===
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

NEXT_PUBLIC_APP_URL=https://seu-dominio.vercel.app

# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/onboarding

# IA (texto) — pipeline, chat do card, assistentes
ANTHROPIC_API_KEY=sk-ant-...

# === Stripe (checkout, portal, webhook) ===
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
# Anual do Pro (R$ 1.490/ano). Sem ele o botão anual devolve 400, por desenho.
STRIPE_PRO_ANNUAL_PRICE_ID=price_...

# === Redes / OAuth (só o que você for usar) ===
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# App da Meta ("API do Instagram com login do Instagram"). Sem eles o botão
# Conectar do Instagram devolve 503, por desenho.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Opcional: segundo app LinkedIn só com Community Management API (páginas de empresa)
LINKEDIN_PAGES_CLIENT_ID=
LINKEDIN_PAGES_CLIENT_SECRET=

TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# === Mídia / pipeline (imagem, infográfico, Veo) ===
GEMINI_API_KEY=

# Higgsfield (lib/media/higgsfield.ts): "id:segredo" da conta da API.
HF_CREDENTIALS=
# Aberturas, cenas de apoio e transições geradas na edição dos cortes.
# Desligado (0) até o dono aprovar o custo por vídeo; só "1" libera o pedido pago.
HIGGSFIELD_NA_EDICAO=0
# Imagem por tipo (lib/media/imagem-higgsfield.ts, 01/10). Vazio = o aprovado
# na prova de 30/09; "google" volta o tipo para o Nano Banana. O Google é
# sempre o recuo (sem vaga, fila cheia, prazo, falta de saldo).
# IMAGEM_COLAGEM=higgsfield-gpt-image-2.5-low
# IMAGEM_ARTE=higgsfield-gpt-image-2.5-low
# IMAGEM_FUNDO=higgsfield-gpt-image-2.5-low
# IMAGEM_ELEMENTO=higgsfield-recraft-v4.1
# IMAGEM_CENARIO=higgsfield-grok-imagine-2.0
# Pedidos de imagem em voo por processo (a conta faz 2; 10 depois de US$ 25 em recargas).
# HIGGSFIELD_IMAGENS_SIMULTANEAS=2

# Conta de serviço GCP (JSON inteiro em UMA linha, sem aspas externas)
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=us-central1
# Bucket público para URLs https://storage.googleapis.com/... (vídeo Veo)
GOOGLE_CLOUD_STORAGE_BUCKET=

# === Cron (Vercel Cron chama /api/cron/pipeline com Bearer) ===
CRON_SECRET=
# Login social. O botao so aparece com NEXT_PUBLIC_*_AUTH=1, e o servidor so
# ativa o provedor com as credenciais presentes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH=
NEXT_PUBLIC_LINKEDIN_AUTH=

# Cloudflare Turnstile, o captcha invisivel do cadastro e dos formularios publicos (01/10).
# Liga sozinho com as DUAS chaves; sem elas, a defesa contra robo funciona pelas outras camadas.
# Ver lib/anti-robo/turnstile.ts.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
