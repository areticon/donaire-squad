# Modelo das variáveis do ambiente de DEV da Demandou (06/10/2026).
#
# Sem segredo nenhum: os valores entre <> são preenchidos no dia em que as
# contas da Demandou existirem. Serve para três lugares:
#   1. Vercel, ambiente Preview (dev.demandou.com): `npx vercel env add NOME preview`
#   2. Railway, ambiente `dev` do projeto `demandou` (só o bloco do WORKER)
#   3. .env.dev.local na pasta do projeto (para migrar e semear pela máquina:
#      node scripts/dev/com-env-dev.mjs npx prisma migrate deploy)
#
# A trava (lib/ambiente/trava-do-banco.mjs) recusa subir se qualquer uma das
# marcadas com [TRAVA] apontar para a produção.

# ─── identidade do ambiente ───
DEMANDOU_AMBIENTE=dev                                   # [TRAVA] sem ela o build do Preview não migra

# ─── banco demandou-dev (Supabase, organização Demandou, plano Free) ───
# Pooler em modo transação (6543) para o app; conexão direta (5432) para migrar.
# NUNCA SET por esta URL (o pooler vaza o SET para outras conexões; 01/10).
DATABASE_URL="postgresql://postgres.<REF_DEV>:<SENHA_DEV>@aws-0-<REGIAO>.pooler.supabase.com:6543/postgres?pgbouncer=true"   # [TRAVA]
DIRECT_URL="postgresql://postgres.<REF_DEV>:<SENHA_DEV>@aws-0-<REGIAO>.pooler.supabase.com:5432/postgres"                    # [TRAVA]

# ─── endereços ───
NEXT_PUBLIC_APP_URL=https://dev.demandou.com            # [TRAVA] vazio cai em demandou.com no código
BETTER_AUTH_URL=https://dev.demandou.com                # [TRAVA]
BETTER_AUTH_SECRET=<NOVO, gerar: openssl rand -hex 32>  # diferente da produção: sessão de dev não vale em produção

# ─── worker de dev (Railway, ambiente dev) ───
VIDEO_WORKER_URL=https://<DOMINIO_DO_WORKER_DEV>.up.railway.app   # [TRAVA]
VIDEO_WORKER_SECRET=<NOVO, igual ao WORKER_SECRET do worker de dev; nunca o de produção>

# ─── cron (chamar à mão em dev: os crons do vercel.json só rodam em produção) ───
CRON_SECRET=<NOVO>

# ─── dinheiro: só modo de teste ───
STRIPE_SECRET_KEY=sk_test_<...>                         # [TRAVA] sk_live_ é recusada
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_<...>
STRIPE_WEBHOOK_SECRET=whsec_<do webhook de teste apontando para https://dev.demandou.com/api/webhooks/stripe>
STRIPE_STARTER_PRICE_ID=price_<teste>
STRIPE_PRO_PRICE_ID=price_<teste>
STRIPE_PRO_ANNUAL_PRICE_ID=price_<teste>
STRIPE_BUSINESS_PRICE_ID=price_<teste>
STRIPE_BUSINESS_ANNUAL_PRICE_ID=price_<teste>
STRIPE_STUDIO_PRICE_ID=price_<teste>
STRIPE_STUDIO_ANNUAL_PRICE_ID=price_<teste>
STRIPE_AGENCY_PRICE_ID=price_<teste>
STRIPE_ACESSO_EXTRA_PRICE_ID=price_<teste>
STRIPE_ACESSO_EXTRA_ANNUAL_PRICE_ID=price_<teste>
STRIPE_FUNDADOR_ANNUAL_PRICE_ID=price_<teste>
STRIPE_FUNDADOR_COUPON_ID=<cupom de teste>
ZAPSIGN_AMBIENTE=sandbox                                # [TRAVA] "producao" é recusado

# ─── nada sai para fora ───
PUBLICAR_VIA_BLOTATO=                                   # [TRAVA] vazio: dev nunca publica em rede
PUBLICAR_VIA_BLOTATO_CONTAS=                            # [TRAVA] idem
# A publicação direta (OAuth) só acontece com conta de rede conectada; a semente não conecta nenhuma.
WHATSAPP_SIMULAR=1
TIKTOK_AMBIENTE=sandbox
ONBOARDING_PESSOA_EMAIL=bruno.donaire@demandou.com
DEMONSTRACAO_AVISAR=bruno.donaire@demandou.com
CONTRATOS_EMAIL=bruno.donaire@demandou.com
CONTRATOS_APROVADOR_EMAIL=bruno.donaire@demandou.com
CONTRATOS_ASSINANTE_EMAIL=bruno.donaire@demandou.com
COBRANCAS_FUP_AUTOMATICO=0

# ─── tetos de gasto (baixos de propósito) ───
EDITOR_TETO_USD_POR_MINUTO=0.5
REFERENCIAS_GASTO_MAX_USD=0.5
METRICAS_APIFY_GASTO_MAX_USD=0.5
VIDEO_GERACOES_POR_DIA=2
HIGGSFIELD_NA_EDICAO=0
DEMO_LIMITE_GLOBAL=5

# ─── chaves de IA e serviços ───
# Opção 1 (agora): as mesmas da produção, protegidas pelos tetos acima.
# Opção 2 (melhor, depois da separação): chaves próprias de dev, na mesma
# organização da Demandou, com limite mensal por chave (Anthropic e OpenAI permitem).
ANTHROPIC_API_KEY=<...>
OPENAI_API_KEY=<...>
GEMINI_API_KEY=<...>
GOOGLE_APPLICATION_CREDENTIALS_JSON=<...>
GOOGLE_CLOUD_PROJECT_ID=<...>
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_STORAGE_BUCKET=<bucket de dev ou o mesmo com prefixo>
DEEPGRAM_API_KEY=<...>
TYPESAFE_API_KEY=<...>
HF_CREDENTIALS=<...>
FAL_KEY=<...>
ELEVENLABS_API_KEY=<...>
HEYGEN_API_KEY=<...>
RESEND_API_KEY=<...>
PIXABAY_API_KEY=<...>
APIFY_TOKEN=<...>

# ─── mídia: store de Blob de dev (separada da produção) ───
BLOB_READ_WRITE_TOKEN=<token da store demandou-dev>
BLOB_PUBLIC_READ_WRITE_TOKEN=<token público da store demandou-dev>
BLOB_STORE_ID=<id da store demandou-dev>

# ─── login social em dev (opcional; sem isso, rede se prova só em produção) ───
# Exige registrar https://dev.demandou.com/api/... como retorno nos apps.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH=
NEXT_PUBLIC_LINKEDIN_AUTH=

# ═══ WORKER (Railway, ambiente dev do projeto demandou) ═══
# Só estas, no serviço video-worker do ambiente dev:
#   DEMANDOU_AMBIENTE=dev
#   WORKER_SECRET=<o mesmo valor do VIDEO_WORKER_SECRET acima>
#   BLOB_READ_WRITE_TOKEN=<store demandou-dev>
#   BLOB_PUBLIC_READ_WRITE_TOKEN=<store demandou-dev>
#   REMOTION_CONCORRENCIA=2
#   WORKER_TRABALHO_FALSO=1        (quando o ensaio não precisa de vídeo real)
# E nas configurações do serviço: App Sleeping ligado (custa quase nada parado).
